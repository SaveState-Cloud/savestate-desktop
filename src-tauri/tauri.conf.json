{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "SaveState Vault",
  "version": "2.0.33",
  "identifier": "dk.savestate.vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SaveState Vault",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.savestate.dk https://*.backblazeb2.com https://*.r2.cloudflarestorage.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "bin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMDJEN0I2RDk4RkJERUQKUldUdHZZL1p0dGNDL080alRXMURiVkM5cmVCVTB5RGM0NzdJK3Z3Qnc2bEVvSFJzUFRjZ0d2dk4K",
      "endpoints": [
        "https://api.savestate.dk/updater/{{target}}/{{current_version}}"
      ]
    }
  }
}
