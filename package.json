{
  "name": "savestate-desktop",
  "version": "2.0.14",
  "description": "Official open-source Windows client for SaveState encrypted backups",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaveState-Cloud/savestate-desktop.git"
  },
  "homepage": "https://savestate.dk",
  "scripts": {
